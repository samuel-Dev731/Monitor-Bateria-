<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="14dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TEMPO DE TELA" android:textColor="#91A0A8"
        android:textSize="10sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_screen_time" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="—" android:textColor="#45E58B"
        android:textSize="28sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Abra o app para consultar"
        android:textColor="#F3F7F5" android:textSize="11sp" />
</LinearLayout>
